# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit a real API key.

# Server-side Groq key. Leave this blank to paste a key in the browser instead.
# A key typed into the web UI is kept in that browser tab only. It is sent with
# each question and is not written to disk or to the server logs.
GROQ_API_KEY=

# Free-tier chat model. Other free options include openai/gpt-oss-120b and qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TEMPERATURE=0.5
GROQ_REASONING_EFFORT=low
GROQ_INCLUDE_REASONING=false

# Local embedding model. The first upload downloads it from Hugging Face.
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
SQLITE_PATH=./data/catalog.db

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
